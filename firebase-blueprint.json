{
  "entities": {
    "academic_records": {
      "title": "Academic Record",
      "description": "Stores student lessons, step-by-step solutions, summaries, and flashcards across educational stages and grades",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the user who created this academic record"
        },
        "stage": {
          "type": "string",
          "enum": ["primary", "intermediate", "preparatory", "assistant"],
          "description": "Educational stage: primary, intermediate, preparatory, or smart assistant"
        },
        "grade": {
          "type": "string",
          "maxLength": 60,
          "description": "Class / grade subdivision name"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the lesson, problem, or topic"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Academic subject name (e.g. Mathematics, Science, Arabic)"
        },
        "mode": {
          "type": "string",
          "maxLength": 50,
          "description": "Activity mode: explain, quiz, solve_problem, summarize, study_plan, flashcards"
        },
        "content": {
          "type": "string",
          "maxLength": 50000,
          "description": "Detailed text content generated by AI"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["userId", "stage", "title", "subject", "mode", "content", "createdAt"]
    },
    "quiz_scores": {
      "title": "Quiz Score",
      "description": "Tracks student scores and performance on academic quizzes",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the student"
        },
        "stage": {
          "type": "string",
          "enum": ["primary", "intermediate", "preparatory", "assistant"],
          "description": "Educational stage of the quiz"
        },
        "quizTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the quiz taken"
        },
        "score": {
          "type": "number",
          "description": "Number of correct answers"
        },
        "total": {
          "type": "number",
          "description": "Total questions in the quiz"
        },
        "percentage": {
          "type": "number",
          "description": "Score percentage from 0 to 100"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of quiz completion"
        }
      },
      "required": ["userId", "stage", "quizTitle", "score", "total", "percentage", "createdAt"]
    },
    "study_schedules": {
      "title": "Study Schedule",
      "description": "Customized study timetable and revision schedule",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the student"
        },
        "stage": {
          "type": "string",
          "enum": ["primary", "intermediate", "preparatory", "assistant"],
          "description": "Educational stage"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Schedule title"
        },
        "hoursPerDay": {
          "type": "number",
          "description": "Target study hours per day"
        },
        "scheduleData": {
          "type": "string",
          "maxLength": 50000,
          "description": "JSON or Markdown formatted timetable"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "stage", "title", "hoursPerDay", "scheduleData", "createdAt"]
    },
    "academic_comments": {
      "title": "Academic Comment & Note",
      "description": "Student comments, questions, and notes posted to lessons across grades",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of author"
        },
        "userName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of student"
        },
        "stage": {
          "type": "string",
          "maxLength": 50,
          "description": "Educational stage"
        },
        "grade": {
          "type": "string",
          "maxLength": 60,
          "description": "Class / grade"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject name"
        },
        "topic": {
          "type": "string",
          "maxLength": 200,
          "description": "Lesson topic"
        },
        "commentText": {
          "type": "string",
          "maxLength": 5000,
          "description": "Comment or note content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp"
        }
      },
      "required": ["userId", "userName", "stage", "grade", "subject", "topic", "commentText", "createdAt"]
    },
    "users": {
      "title": "User Profile",
      "description": "User profile information including role and subscription plan",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier for the user"
        },
        "email": {
          "type": "string",
          "maxLength": 255,
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Teacher", "Student"],
          "description": "User role in the platform"
        },
        "plan": {
          "type": "string",
          "enum": ["Free", "Smart", "VIP"],
          "description": "Subscription tier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["uid", "email", "role", "plan", "createdAt"]
    },
    "connection_test": {
      "title": "Connection Test",
      "description": "Heartbeat entity to test live Firestore connection",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 50,
          "description": "Status message"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last ping time"
        }
      },
      "required": ["status"]
    },
    "physics_leaderboard": {
      "title": "Physics Puzzle Leaderboard",
      "description": "Records completion times and scores for the physics puzzle challenge",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID or identifier of the player"
        },
        "userName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the player"
        },
        "levelId": {
          "type": "number",
          "description": "Numeric ID of the completed puzzle level"
        },
        "levelName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the puzzle level"
        },
        "timeSeconds": {
          "type": "number",
          "description": "Time elapsed in seconds to solve the puzzle"
        },
        "movesCount": {
          "type": "number",
          "description": "Number of moves, shots, or attempts taken"
        },
        "stars": {
          "type": "number",
          "description": "Performance rating from 1 to 3 stars"
        },
        "solvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of solution completion"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "userName", "levelId", "levelName", "timeSeconds", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/users"
      },
      "description": "Collection of user profiles, roles, and subscription data"
    },
    "/academic_records/{recordId}": {
      "schema": {
        "$ref": "#/entities/academic_records"
      },
      "description": "Collection of academic lessons, problem solutions, and student notes"
    },
    "/quiz_scores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/quiz_scores"
      },
      "description": "Collection of quiz scores and progress records"
    },
    "/study_schedules/{scheduleId}": {
      "schema": {
        "$ref": "#/entities/study_schedules"
      },
      "description": "Collection of customized student study plans"
    },
    "/academic_comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/academic_comments"
      },
      "description": "Collection of student comments, discussion notes, and questions"
    },
    "/test/{testId}": {
      "schema": {
        "$ref": "#/entities/connection_test"
      },
      "description": "Collection for connectivity and heartbeat verification"
    },
    "/physics_leaderboard/{scoreId}": {
      "schema": {
        "$ref": "#/entities/physics_leaderboard"
      },
      "description": "Collection of leaderboard entries for physics puzzle solutions"
    }
  }
}
